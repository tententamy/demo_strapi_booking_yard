{
  "kind": "collectionType",
  "collectionName": "invoice_items",
  "info": {
    "singularName": "invoice-item",
    "pluralName": "invoice-items",
    "displayName": "InvoiceItem"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "hourly",
        "daily",
        "event",
        "addon"
      ]
    },
    "descripton": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "unit": {
      "type": "string"
    },
    "unitPrice": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "totalPrice": {
      "type": "decimal"
    },
    "startTime": {
      "type": "datetime"
    },
    "endTime": {
      "type": "datetime"
    },
    "eventDetails": {
      "type": "component",
      "component": "event-details.event-details",
      "repeatable": false
    },
    "invoice": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::invoice.invoice",
      "inversedBy": "invoice_items"
    },
    "yard_booking": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::yard-booking.yard-booking",
      "inversedBy": "invoice_items"
    },
    "service": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service.service",
      "inversedBy": "invoice_items"
    },
    "yard": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::yard.yard",
      "inversedBy": "invoice_items"
    }
  }
}

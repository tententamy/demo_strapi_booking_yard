{
  "kind": "collectionType",
  "collectionName": "yards",
  "info": {
    "singularName": "yard",
    "pluralName": "yards",
    "displayName": "Yard"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "location": {
      "type": "string"
    },
    "status_yard": {
      "type": "enumeration",
      "required": true,
      "default": "available",
      "enum": [
        "available",
        "maintenance",
        "booked"
      ]
    },
    "photo": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "equipmentIncluded": {
      "type": "string"
    },
    "maxCapacity": {
      "type": "integer"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "yard_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::yard-type.yard-type",
      "inversedBy": "yards"
    },
    "yard_bookings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::yard-booking.yard-booking",
      "mappedBy": "yard"
    },
    "invoice_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invoice-item.invoice-item",
      "mappedBy": "yard"
    }
  }
}

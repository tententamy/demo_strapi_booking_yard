{
  "kind": "collectionType",
  "collectionName": "yard_types",
  "info": {
    "singularName": "yard-type",
    "pluralName": "yard-types",
    "displayName": "YardType"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "capacity": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "basePricePerHour": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "basePricePerDay": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "eventMultiplier": {
      "type": "decimal",
      "default": 1
    },
    "pricingTiers": {
      "type": "json"
    },
    "yards": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::yard.yard",
      "mappedBy": "yard_type"
    }
  }
}

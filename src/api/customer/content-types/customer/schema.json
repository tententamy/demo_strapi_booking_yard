{
  "kind": "collectionType",
  "collectionName": "customers",
  "info": {
    "singularName": "customer",
    "pluralName": "customers",
    "displayName": "Customer",
    "description": "Khách hàng - Info cá nhân & Thanh toán"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "string"
    },
    "dateOfBirth": {
      "type": "datetime"
    },
    "loyaltyPoints": {
      "type": "integer",
      "default": 0
    },
    "walletBalance": {
      "type": "decimal",
      "default": 0
    },
    "paymentMethods": {
      "type": "json"
    },
    "isVerified": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}